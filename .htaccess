# ==========================================
# Hostinger / LiteSpeed Server Configuration
# Charan Golkonda Portfolio
# ==========================================

RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Legacy Redirects
RewriteRule ^stills/?$ /photography [R=301,L]
RewriteRule ^reels/?$ /verticals [R=301,L]

# 3. Clean URLs (Serve .html without showing .html in URL)
# If requested URL exists as a directory or real file, serve directly
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# If .html version of the file exists, rewrite internally
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 4. Media Streaming & Byte-Range Support (Prevents video lag)
<IfModule mod_headers.c>
    # Enable partial byte requests for video scrubbing and instant start
    <FilesMatch "\.(mp4|mov|webm)$">
        Header set Accept-Ranges bytes
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Static assets long-term caching
    <FilesMatch "\.(jpg|jpeg|png|webp|svg|gif|ico|css|js|woff|woff2|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Dynamic HTML must revalidate
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

# 5. Prevent server from re-compressing already compressed video formats
<IfModule mod_deflate.c>
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|mp4|mov|webm)$ no-gzip dont-vary
</IfModule>

# 6. Correct MIME Types
<IfModule mod_mime.c>
    AddType video/mp4 .mp4
    AddType video/quicktime .mov
    AddType video/webm .webm
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>
